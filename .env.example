# ==============================================================================
# SAKUIN — ENVIRONMENT CONFIGURATION TEMPLATE
# Maintainer: Farish Ilham Syahrani <farishilham.s@gmail.com>
# Repository: https://github.com/farishilhams/Sakuin.git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local atau MongoDB Atlas URI)
# Contoh Local: mongodb://localhost:27017/sakuin
# Contoh Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sakuin?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sakuin

# Keamanan Token JWT & Express Session
JWT_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_sakuin
JWT_EXPIRES_IN=7d
SESSION_SECRET=ganti_dengan_kunci_sesi_unik_sakuin_farish_ilham_syahrani

# Origin URL Frontend Client (untuk CORS & Redirect OAuth)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 CREDENTIALS
# Panduan pembuatan di Google Cloud Console:
# 1. Buka https://console.cloud.google.com/
# 2. Buat project "Sakuin", masuk ke APIs & Services > Credentials
# 3. Buat OAuth 2.0 Client ID (Web Application)
# 4. Authorized JavaScript origins: http://localhost:5173
# 5. Authorized redirect URIs: http://localhost:5000/api/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=masukkan_google_client_id_anda.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=masukkan_google_client_secret_anda
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_PUBLIC_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=masukkan_google_client_id_anda.apps.googleusercontent.com
VITE_PUBLIC_MAINTENANCE_MODE=false
